# Token HuggingFace (gratuit sur huggingface.co/settings/tokens)
# Requis pour télécharger le modèle pyannote
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle Whisper : tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3

# Modèle Ollama
OLLAMA_MODEL=mistral

# Port de l'application
PORT=8000

# Dossier de stockage audio
STORAGE_DIR=./storage/audio

# Base de données (laisser vide pour SQLite local, ou surcharger pour Docker)
# DATABASE_URL=sqlite+aiosqlite:////app/data/meetvault.db
